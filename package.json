{
  "name": "@schematic-form/react",
  "version": "0.1.0-beta.2",
  "description": "React-first JSON Schema form renderer built with HeroUI v3.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuriydyuster/schematic-form"
  },
  "bugs": {
    "url": "https://github.com/yuriydyuster/schematic-form/issues"
  },
  "homepage": "https://github.com/yuriydyuster/schematic-form#readme",
  "keywords": [
    "react",
    "json-schema",
    "forms",
    "heroui",
    "ajv",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('dist', {recursive: true, force: true}))\"",
    "build:storybook": "HOME=.cache/storybook STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:acceptance": "vite --host 127.0.0.1",
    "test:acceptance": "playwright test",
    "test:acceptance:install": "playwright install chromium"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.18.0",
    "@internationalized/date": "^3.12.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.8"
  }
}
